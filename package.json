{
  "name": "cs-teacher-test-series",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build:bank": "tsx scripts/build-question-bank.ts",
    "predev": "npm run build:bank",
    "dev": "next dev",
    "prebuild": "npm run build:bank",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "dev:local": "npm run build:bank && node scripts/dev-local.mjs",
    "emulators": "npx -y firebase-tools@15 emulators:start --only auth,firestore --project demo-cs-test",
    "translate:hindi": "node scripts/translate-hindi.mjs",
    "seed:demo": "node scripts/seed-demo-users.mjs"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "overrides": {
    "@firebase/app": "0.16.2",
    "@firebase/app-compat": "0.5.18"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
